# ipsec-hub — non-interactive preset
#
#   cp examples/hub.env.example /root/hub.env && $EDITOR /root/hub.env
#   set -a; . /root/hub.env; set +a
#   HUB_NONINTERACTIVE=1 ./ipsec-hub install
#
# Any key left unset falls back to the wizard default. In non-interactive mode
# the wizard never prompts, so anything site-specific below must be set.

# --- identity ----------------------------------------------------------------
# Public hostname clients dial. Must already resolve to this VPS.
HUB_FQDN=vpn.example.com
# Suffix for certificate identities: clients get <name>@ID_DOMAIN,
# the site gets <HOME_NAME>.sites.ID_DOMAIN. Defaults to HUB_FQDN.
ID_DOMAIN=vpn.example.com
# Autodetected when unset.
WAN_IF=
PUBLIC_IP4=

# --- public port -------------------------------------------------------------
# hybrid = custom port + UDP/500 (needed by native iPhone/iPad/macOS clients)
# custom = the custom port only; strongSwan-based clients and RouterOS only
PORT_MODE=hybrid
# 1024-65535, not 500/4500. Random when unset.
IKE_PORT=45123

# --- overlay -----------------------------------------------------------------
# One RFC1918 /23, aligned. First /24 = client pool, base+257 = management IP.
OVERLAY4=10.99.0.0/23
# block = capture ::/0 and reject fast (no leak) | nat66 = NAT66 out of the VPS
IPV6_MODE=block
# DNS pushed to clients. Leave empty to push none.
CLIENT_DNS=192.168.10.1

# --- crypto ------------------------------------------------------------------
# require = ML-KEM-1024 mandatory (needs strongSwan with ML-KEM *and* iOS/macOS 26)
# prefer  = offer it, fall back to ECP-384 | off = classical only
PQ_MODE=prefer

# --- egress ------------------------------------------------------------------
# vps = masquerade out of the VPS WAN | home = policy-route via the site (fail-closed)
EGRESS=home

# --- home site ---------------------------------------------------------------
HOME_ENABLED=yes
HOME_NAME=home-gw
# Comma-separated LANs reachable behind the router (ignored when EGRESS=home,
# which uses 0.0.0.0/0 on the site child SA).
HOME_LANS=192.168.10.0/24,192.168.20.0/24
# cert = ECDSA P-384 mutual certs | psk = random 48-char PSK (RouterOS fallback)
HOME_AUTH=cert

# --- clients -----------------------------------------------------------------
# Apple profile: always-on (OnDemand + IncludeAllNetworks + ExcludeLocalNetworks).
APPLE_ONDEMAND=yes

# --- management --------------------------------------------------------------
# Public SSH allowed from these sources until 'ipsec-hub lockdown'.
# Empty means no public SSH at all — only set that if you already have tunnel access.
SSH_BOOTSTRAP=198.51.100.7/32
SNMP_ENABLED=yes
SNMP_USER=monitor
NODE_EXPORTER=yes
HARDEN_SSH=yes
AUTO_UPDATES=yes
