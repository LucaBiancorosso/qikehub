# qikehub (lite) — non-interactive preset
#
#   cp examples/qikehub.env.example /root/qikehub.env && $EDITOR /root/qikehub.env
#   set -a; . /root/qikehub.env; set +a
#   HUB_NONINTERACTIVE=1 ./qikehub install
#
# Any key left unset falls back to the wizard default. In non-interactive mode
# the wizard never prompts, so anything site-specific below must be set.

# --- identity ----------------------------------------------------------------
# Public hostname clients dial. Must already resolve to this VPS.
HUB_FQDN=vpn.example.com
# Autodetected when unset.
WAN_IF=
PUBLIC_IP4=

# --- public port -------------------------------------------------------------
# 1024-65535. Random when unset. No dual-port dance needed — unlike the IPsec
# version, every WireGuard client (including iOS/macOS) can dial any port.
WG_PORT=45123

# --- overlay -----------------------------------------------------------------
# One /24. The hub itself takes the first address (e.g. 10.99.0.1); the home
# site (if enabled) takes the last (10.99.0.254); clients get the rest.
POOL4=10.99.0.0/24
# block = capture ::/0 and reject fast (no leak) | nat66 = NAT66 out of the VPS
IPV6_MODE=block
# DNS pushed to clients.
CLIENT_DNS=9.9.9.9,149.112.112.112

# --- egress ------------------------------------------------------------------
# vps = masquerade out of the VPS WAN | home = policy-route via the site (fail-closed)
EGRESS=vps

# --- home site ---------------------------------------------------------------
HOME_ENABLED=no
HOME_NAME=home-gw
# Comma-separated LANs reachable behind the router (ignored when EGRESS=home,
# which routes 0.0.0.0/0 to the site instead).
HOME_LANS=192.168.10.0/24

# --- management --------------------------------------------------------------
# Public SSH allowed from these sources until 'qikehub lockdown'.
# Empty means no public SSH at all — only set that if you already have tunnel access.
SSH_BOOTSTRAP=198.51.100.7/32
HARDEN_SSH=yes
AUTO_UPDATES=yes
